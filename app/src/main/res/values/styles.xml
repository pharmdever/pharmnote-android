<resources>
 <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans-serif</item><item name="android:colorAccent">#315C4D</item>
  <item name="android:colorControlNormal">#81958A</item><item name="android:windowLightStatusBar">true</item>
  <item name="android:windowLightNavigationBar">true</item><item name="android:statusBarColor">#F6F8F3</item>
  <item name="android:navigationBarColor">#F6F8F3</item><item name="android:windowActionModeOverlay">true</item>
  <item name="android:windowBackground">#F6F8F3</item><item name="android:alertDialogTheme">@style/PharmnoteDialog</item>
 </style>
 <style name="PharmnoteDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
  <item name="android:fontFamily">sans-serif</item><item name="android:colorAccent">#315C4D</item>
  <item name="android:windowBackground">@drawable/dialog_surface</item><item name="android:windowMinWidthMajor">92%</item>
  <item name="android:windowMinWidthMinor">92%</item><item name="android:windowSoftInputMode">adjustResize</item>
 </style>
</resources>
